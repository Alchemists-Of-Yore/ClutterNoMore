{
  "priority": 500,
  "add": {
    "/(?<ns>[^:]+):(?<wood>.+)_log/": [
      "${ns}:${wood}_wood",
      "wilderwild:hollowed_${wood}_log",
      "quark:hollow_${wood}_log",
      "quark:hollow_${wood}_stem",
      "everycomp:q/${ns}/hollow_${wood}_log"
    ],

    "/(?<ns>[^:]+):(?<wood>.*wood.*)_log/": [
      "${ns}:${wood}"
    ],

    "/(?<ns>[^:]+):stripped_(?<wood>.+)_log/": [
      "wilderwild:stripped_hollowed_${wood}_log"
    ],

    "/minecraft:(?<stem>.+?)(?<end>_planks)/": {
      "shapes": [
        "/(?!minecraft:)[^:]+:${stem}_slab/",
        "/(?!minecraft:)[^:]+:${stem}_stairs/",
        "/(?!minecraft:)[^:]+:${stem}_wall/",
        "/(?!minecraft:)[^:]+:${stem}${end}_slab/",
        "/(?!minecraft:)[^:]+:${stem}${end}_stairs/",
        "/(?!minecraft:)[^:]+:${stem}${end}_stair/",
        "/(?!minecraft:)[^:]+:${stem}${end}_wall/"
      ],
      "conditions": {
        "is_blockitem": true
      }
    },

    "/minecraft:(?<stem>.+?)(?<end>_block)/": {
      "shapes": [
        "/(?!minecraft:)[^:]+:${stem}_slab/",
        "/(?!minecraft:)[^:]+:${stem}_stairs/",
        "/(?!minecraft:)[^:]+:${stem}_wall/",
        "/(?!minecraft:)[^:]+:${stem}${end}_slab/",
        "/(?!minecraft:)[^:]+:${stem}${end}_stairs/",
        "/(?!minecraft:)[^:]+:${stem}${end}_stair/",
        "/(?!minecraft:)[^:]+:${stem}${end}_wall/"
      ],
      "conditions": {
        "is_blockitem": true,
        "not": { "exists": ["/[^:]+:${stem}_planks/"] }
      }
    },

    "/minecraft:(?<stem>.+?)(?<end>s|)/": {
      "shapes": [
        "/(?!minecraft:)[^:]+:${stem}_slab/",
        "/(?!minecraft:)[^:]+:${stem}_stairs/",
        "/(?!minecraft:)[^:]+:${stem}_wall/",
        "/(?!minecraft:)[^:]+:${stem}${end}_slab/",
        "/(?!minecraft:)[^:]+:${stem}${end}_stairs/",
        "/(?!minecraft:)[^:]+:${stem}${end}_wall/"
      ],
      "conditions": {
        "is_blockitem": true,
        "none_of": [
          { "exists": ["/[^:]+:${stem}_planks/"] },
          { "exists": ["/[^:]+:${stem}_block/"] }
        ]
      }
    },

    "/(?<ns>[^:]+):(?<stem>.+?)(?<end>_planks)/": {
      "shapes": [
        "${ns}:${stem}_slab",
        "${ns}:${stem}_stairs",
        "${ns}:${stem}_wall",
        "${ns}:${stem}${end}_slab",
        "${ns}:${stem}${end}_stairs",
        "${ns}:${stem}${end}_stair",
        "${ns}:${stem}${end}_wall",

        "${ns}:spiked_${stem}",
        "${ns}:spiked_${stem}${end}"
      ],
      "conditions": {
        "is_blockitem": true
      }
    },

    "/(?<ns>[^:]+):(?<stem>.+?)(?<end>_block)/": {
      "shapes": [
        "${ns}:${stem}_slab",
        "${ns}:${stem}_stairs",
        "${ns}:${stem}_wall",
        "${ns}:${stem}${end}_slab",
        "${ns}:${stem}${end}_stairs",
        "${ns}:${stem}${end}_stair",
        "${ns}:${stem}${end}_wall",

        "${ns}:spiked_${stem}",
        "${ns}:spiked_${stem}${end}"
      ],
      "conditions": {
        "is_blockitem": true,
        "not": { "exists": ["${ns}:${stem}_planks"] }
      }
    },

    "/(?<ns>[^:]+):(?<stem>.+?)(?<end>s|)/": {
      "shapes": [
        "${ns}:${stem}_slab",
        "${ns}:${stem}_stairs",
        "${ns}:${stem}_wall",
        "${ns}:${stem}${end}_slab",
        "${ns}:${stem}${end}_stairs",
        "${ns}:${stem}${end}_wall",

        "${ns}:spiked_${stem}",
        "${ns}:spiked_${stem}${end}"
      ],
      "conditions": {
        "is_blockitem": true,
        "none_of": [
          { "exists": ["${ns}:${stem}_planks"] },
          { "exists": ["${ns}:${stem}_block"] }
        ]
      }
    },

    "/(?<ns>[^:]+):stripped_(?<wood>.+?)_palisade/": [
      "${ns}:stripped_spiked_${wood}_palisade"
    ],

    "/minecraft:(?<stem>.+)_slab/": [
      "clutternomore:vertical_${stem}_slab"
    ],

    "/(?<ns>[^:]+):(?<stem>.+)_slab/": [
      "clutternomore:${ns}/vertical_${stem}_slab",
      "${ns}:vertical_${stem}_slab",
      "${ns}:${stem}_vertical_slab"
    ],

    "/minecraft:(?<stem>.+)_stair(s|)/": [
      "clutternomore:${stem}_step"
    ],

    "/(?<ns>[^:]+):(?<stem>.+)_stair(s|)/": [
      "clutternomore:${ns}/${stem}_step",
      "${ns}:${stem}_step"
    ],

    "/(?<ns>[^:]+):(?<wood>.+)_stem/": [
      "${ns}:${wood}_hyphae",
      "quark:hollow_${wood}_stem",
      "everycomp:q/${ns}/hollow_${wood}_stem"
    ]
  },
  "remove": {
    "#clutternomore:shape_map_blacklist": ["/.*/"],
    "/.*/": [
      "/[^:]+:copycat.*/",
      "#clutternomore:shape_map_blacklist"
    ]
  }
}
