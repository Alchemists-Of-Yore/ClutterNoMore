      "shapes": [
        "pyrite:${stem}_wall_gate/",
        "pyrite:${stem}${end}_wall_gate/"
      ],
      "conditions": {
        "is_blockitem": true,
        "not": { "exists": ["/[^:]+:${stem}_planks/"] }
      }
    },

    "/minecraft:(?<stem>.+?)(?<end>s|)/": {
      "shapes": [
        "pyrite:${stem}_wall_gate/",
        "pyrite:${stem}${end}_wall_gate/"
      ],
      "conditions": {
        "is_blockitem": true,
        "none_of": [
          { "exists": ["/[^:]+:${stem}_planks/"] },
          { "exists": ["/[^:]+:${stem}_block/"] }
        ]
      }
    },

