      "pyrite:path_stairs"
    ],
    "/dye_depot:(?<stem>.+?)_block/": {
      "shapes": [
        "dye_the_world:${stem}_slab",
        "dye_the_world:${stem}_stairs",
        "dye_the_world:${stem}_wall"
      ],
      "conditions": {
        "is_blockitem": true
      }
    },
    "/dye_depot:(?<stem>.+?)(?<end>s|)/": {
      "shapes": [
        "dye_the_world:${stem}_slab",
        "dye_the_world:${stem}_stairs",
        "dye_the_world:${stem}_wall",
        "dye_the_world:${stem}${end}_slab",
        "dye_the_world:${stem}${end}_stairs",
        "dye_the_world:${stem}${end}_wall"
      ],
      "conditions": {
        "is_blockitem": true,
        "not": { "exists": ["/[^:]+:${stem}_block/"] }
      }
    },


    "/minecraft:(?<stem>.+?)(?<end>_planks)/": {
      "shapes": [
        "pyrite:${stem}_wall_gate/",
        "pyrite:${stem}${end}_wall_gate/"
      ],
      "conditions": {
        "is_blockitem": true
      }
    },

