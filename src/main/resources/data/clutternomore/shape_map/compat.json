{
  "priority": 500,
  "add": {
    "glass": [
      "create:tiled_glass",
      "create:framed_glass",
      "create:horizontal_framed_glass",
      "create:vertical_framed_glass"
    ],
    "glass_pane": [
      "create:tiled_glass_pane",
      "create:framed_glass_pane",
      "create:horizontal_framed_glass_pane",
      "create:vertical_framed_glass_pane"
    ],
    "clayworks:glass_door": [
      "create:framed_glass_door"
    ],
    "clayworks:glass_trapdoor": [
      "create:framed_glass_trapdoor"
    ],
    "create:gearbox": [
      "create:vertical_gearbox"
    ],
    "create:linear_chassis": [
      "create:secondary_linear_chassis"
    ],
    "create:white_sail": [
      "simulated:white_symmetric_sail",
      "create:sail_frame"
    ],
    "supplementaries:timber_frame": [
      "supplementaries:timber_brace",
      "supplementaries:timber_cross_brace"
    ],
    "supplementaries:daub_frame": [
      "supplementaries:daub_brace",
      "supplementaries:daub_cross_brace"
    ],
    "/(minecraft|dye_depot):(?<color>.+)_banner/": [
      "supplementaries:flag_${color}"
    ],
    "/create:(?<color>.+)_seat/": [
      "bits_n_bobs:${color}_chair"
    ],
    "podzol": ["pyrite:podzol_turf"],
    "mycelium": ["pyrite:mycelium_turf"],
    "grass_block": ["pyrite:grass_turf"],
    "dirt_path": [
      "pyrite:path_turf",
      "pyrite:path_slab",
      "pyrite:path_stairs"
    ],
    "/dye_depot:(?<stem>.+?)(?<end>_block)/": {
      "shapes": [
        "/dye_the_world:${stem}_slab/",
        "/dye_the_world:${stem}_stairs/",
        "/dye_the_world:${stem}_wall/",
        "/dye_the_world:${stem}${end}_slab/",
        "/dye_the_world:${stem}${end}_stairs/",
        "/dye_the_world:${stem}${end}_stair/",
        "/dye_the_world:${stem}${end}_wall/"
      ],
      "conditions": {
        "is_blockitem": true
      }
    },
    "/dye_depot:(?<stem>.+?)(?<end>s|)/": {
      "shapes": [
        "/dye_the_world:${stem}_slab/",
        "/dye_the_world:${stem}_stairs/",
        "/dye_the_world:${stem}_wall/",
        "/dye_the_world:${stem}${end}_slab/",
        "/dye_the_world:${stem}${end}_stairs/",
        "/dye_the_world:${stem}${end}_wall/"
      ],
      "conditions": {
        "is_blockitem": true,
        "none_of": [
          { "exists": ["/[^:]+:${stem}_block/"] }
        ]
      }
    }
  },
  "remove": {
    "/[^:]+:copycat.*/": ["/.*/"],

    "/minecraft:.*tuff.*/": ["/caverns_and_chasms:.*tuff.*/"],
    "/caverns_and_chasms:.*tuff.*/": ["/minecraft:.*tuff.*/"],
    "/minecraft:.*quartz.*/": ["/ae2:.*quartz.*/"],
    "/ae2:.*quartz.*/": ["/minecraft:.*quartz.*/"]
  }
}
